# Copy this file to secret.properties (in the same folder as replaceproperties.sh
# and application.properties) and fill in real values.
# chmod 600 secret.properties   (replaceproperties.sh enforces this anyway)
# Never commit the real file to git.
# Keys must be ENV_VAR_STYLE (letters / digits / underscore only).

# ---- Database ----
DB_URL=jdbc:mysql://<rds-host>:3306/realestate_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=
DB_PASSWORD=

# Use "validate" in production, "update" in dev/QA
DDL_AUTO=validate

# ---- AWS S3 ----
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=re-api-qa
AWS_REGION=ap-south-1

# ---- Twilio (SMS / WhatsApp) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+12762626783

# ---- Mail (AWS SES SMTP) ----
MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- JWT ----
# Generate with: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_HOURS=24

# ---- CIBIL API ----
CIBIL_API_HOST=https://sandbox.surepass.io
CIBIL_API_TOKEN=

# ---- CORS (comma-separated origins for prod) ----
CORS_ALLOWED_ORIGINS=https://app.keybricks.in,https://admin.keybricks.in

# ---- Misc ----
ADMIN_EMAIL=
ADMIN_MOBILE=
PORT=8080
