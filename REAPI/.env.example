# Copy this file to .env and fill in real values. Never commit .env to git.

# Database
DB_URL=jdbc:mysql://localhost:3306/realestate_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=myuser
DB_PASSWORD=

# JPA — use "validate" in production, "update" in dev/QA
DDL_AUTO=update

# AWS S3
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=re-api-qa
AWS_REGION=ap-south-1

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+12762626783

# Mail (AWS SES SMTP or Gmail)
MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_HOURS=24

# CIBIL API
CIBIL_API_HOST=https://sandbox.surepass.io
CIBIL_API_TOKEN=

# Optional
ADMIN_EMAIL=
ADMIN_MOBILE=
PORT=8080
